## Test suite for the semver package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as semver

function test_parsing_and_formatting(r)
    let v1 = semver::parse("1.2.3")
    runner_assert_eq(r, v1.major, 1, "parse basic major")
    runner_assert_eq(r, v1.minor, 2, "parse basic minor")
    runner_assert_eq(r, v1.patch, 3, "parse basic patch")
    runner_assert_str_eq(r, semver::format(v1), "1.2.3", "format basic")

    let v2 = semver::parse("v2.4.6-alpha.1+build.2026")
    runner_assert(r, v2.major == 2 and v2.minor == 4 and v2.patch == 6, "parse v prefix")
    runner_assert_str_eq(r, v2.prerelease, "alpha.1", "parse prerelease")
    runner_assert_str_eq(r, v2.build, "build.2026", "parse build meta")
    runner_assert_str_eq(r, semver::format(v2), "2.4.6-alpha.1+build.2026", "format complex")

    let v3 = semver::parse("3.8")
    runner_assert(r, v3.major == 3 and v3.minor == 8 and v3.patch == 0, "parse loose 2-parts")
end

function test_validation(r)
    runner_assert_eq(r, semver::is_valid("1.0.0"), true, "valid 1.0.0")
    runner_assert_eq(r, semver::is_valid("v2.3.4"), true, "valid v2.3.4")
    runner_assert_eq(r, semver::is_valid("1.0.0-rc.1"), true, "valid with prerelease")
    runner_assert_eq(r, semver::is_valid("a.b.c"), false, "invalid non-number")
    runner_assert_eq(r, semver::is_valid(""), false, "invalid empty")
end

@cfg(feature = "compare")
function test_comparison(r)
    let v1 = semver::parse("1.0.0")
    let v2 = semver::parse("2.0.0")
    let v3 = semver::parse("1.1.0")
    let v4 = semver::parse("1.0.1")

    runner_assert_eq(r, semver::compare(v1, v2), -1, "compare major 1 < 2")
    runner_assert_eq(r, semver::compare(v2, v1), 1, "compare major 2 > 1")
    runner_assert_eq(r, semver::compare(v3, v1), 1, "compare minor 1.1.0 > 1.0.0")
    runner_assert_eq(r, semver::compare(v4, v1), 1, "compare patch 1.0.1 > 1.0.0")
    runner_assert_eq(r, semver::compare(v1, semver::parse("1.0.0")), 0, "compare equal")

    # SemVer Spec: 1.0.0-alpha < 1.0.0
    let v_pre = semver::parse("1.0.0-alpha")
    runner_assert_eq(r, semver::compare(v_pre, v1), -1, "prerelease lower than normal")

    # SemVer Spec: 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-beta < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0
    let v_a = semver::parse("1.0.0-alpha")
    let v_a1 = semver::parse("1.0.0-alpha.1")
    let v_b = semver::parse("1.0.0-beta")
    let v_b2 = semver::parse("1.0.0-beta.2")
    let v_b11 = semver::parse("1.0.0-beta.11")
    let v_rc = semver::parse("1.0.0-rc.1")

    runner_assert_eq(r, semver::lt(v_a, v_a1), true, "precedence alpha < alpha.1")
    runner_assert_eq(r, semver::lt(v_a1, v_b), true, "precedence alpha.1 < beta")
    runner_assert_eq(r, semver::lt(v_b, v_b2), true, "precedence beta < beta.2")
    runner_assert_eq(r, semver::lt(v_b2, v_b11), true, "precedence numeric beta.2 < beta.11")
    runner_assert_eq(r, semver::lt(v_b11, v_rc), true, "precedence beta.11 < rc.1")

    # Build metadata ignored
    let v_b1 = semver::parse("1.0.0+build.1")
    let v_b2 = semver::parse("1.0.0+build.2")
    runner_assert_eq(r, semver::eq(v_b1, v_b2), true, "build metadata ignored in comparison")
end

@cfg(feature = "bump")
function test_bumping_and_diff(r)
    let v = semver::parse("1.2.3")

    let v_maj = semver::bump_major(v)
    runner_assert_str_eq(r, semver::format(v_maj), "2.0.0", "bump major")

    let v_min = semver::bump_minor(v)
    runner_assert_str_eq(r, semver::format(v_min), "1.3.0", "bump minor")

    let v_pat = semver::bump_patch(v)
    runner_assert_str_eq(r, semver::format(v_pat), "1.2.4", "bump patch")

    let v_pre1 = semver::bump_prerelease(v, "alpha")
    runner_assert_str_eq(r, semver::format(v_pre1), "1.2.3-alpha.1", "bump prerelease initial")

    let v_pre2 = semver::bump_prerelease(v_pre1)
    runner_assert_str_eq(r, semver::format(v_pre2), "1.2.3-alpha.2", "bump prerelease increment")

    runner_assert_str_eq(r, semver::diff(v, v_maj), "major", "diff major")
    runner_assert_str_eq(r, semver::diff(v, v_min), "minor", "diff minor")
    runner_assert_str_eq(r, semver::diff(v, v_pat), "patch", "diff patch")
end

@cfg(feature = "range")
function test_range_satisfaction(r)
    # Exact & comparators
    runner_assert_eq(r, semver::satisfies_string("1.2.3", "1.2.3"), true, "satisfies exact")
    runner_assert_eq(r, semver::satisfies_string("1.2.3", "=1.2.3"), true, "satisfies exact with equal")
    runner_assert_eq(r, semver::satisfies_string("1.5.0", ">=1.2.0"), true, "satisfies gte true")
    runner_assert_eq(r, semver::satisfies_string("1.1.0", ">=1.2.0"), false, "satisfies gte false")

    # Conjunction (AND)
    runner_assert_eq(r, semver::satisfies_string("1.5.0", ">=1.0.0 <2.0.0"), true, "satisfies conjunction in range")
    runner_assert_eq(r, semver::satisfies_string("2.0.0", ">=1.0.0 <2.0.0"), false, "satisfies conjunction out of range")

    # Caret (^)
    runner_assert_eq(r, semver::satisfies_string("1.2.4", "^1.2.3"), true, "satisfies caret patch")
    runner_assert_eq(r, semver::satisfies_string("1.9.0", "^1.2.3"), true, "satisfies caret minor")
    runner_assert_eq(r, semver::satisfies_string("2.0.0", "^1.2.3"), false, "satisfies caret major breaking")
    runner_assert_eq(r, semver::satisfies_string("0.2.5", "^0.2.3"), true, "satisfies caret zero minor allowed")
    runner_assert_eq(r, semver::satisfies_string("0.3.0", "^0.2.3"), false, "satisfies caret zero minor breaking")

    # Tilde (~)
    runner_assert_eq(r, semver::satisfies_string("1.2.9", "~1.2.3"), true, "satisfies tilde patch allowed")
    runner_assert_eq(r, semver::satisfies_string("1.3.0", "~1.2.3"), false, "satisfies tilde minor breaking")

    # Wildcards
    runner_assert_eq(r, semver::satisfies_string("1.9.9", "1.*"), true, "satisfies wildcard 1.*")
    runner_assert_eq(r, semver::satisfies_string("4.2.0", "*"), true, "satisfies wildcard star all")

    # Pipe (OR)
    runner_assert_eq(r, semver::satisfies_string("1.5.0", "^1.0.0 || ^2.0.0"), true, "satisfies pipe branch 1")
    runner_assert_eq(r, semver::satisfies_string("2.5.0", "^1.0.0 || ^2.0.0"), true, "satisfies pipe branch 2")
    runner_assert_eq(r, semver::satisfies_string("3.0.0", "^1.0.0 || ^2.0.0"), false, "satisfies pipe outside")
end

function main()
    test_suite("Alya SemVer Package Test Suite")
    let r = runner_new()

    test_parsing_and_formatting(r)
    test_validation(r)
    @cfg(feature = "compare")
    test_comparison(r)
    @cfg(feature = "bump")
    test_bumping_and_diff(r)
    @cfg(feature = "range")
    test_range_satisfaction(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
