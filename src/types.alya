## # semver/types
##
## SemVer types and low-level string helpers.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines release increment kinds, the `Version` model, and internal
## string and character inspection utilities shared by the package.

# ───────────────────────────────────────────────────────────────
# Public Models
# ───────────────────────────────────────────────────────────────

## Public enumeration for release increment types.
##
## Used by `bump` to select the version component being incremented.
pub enum ReleaseType
    Major = 0,
    Minor = 1,
    Patch = 2,
    Prerelease = 3
end

## Public SemVer Version model.
##
## Holds parsed numeric components alongside prerelease and build metadata.
##
## ### Fields
## - `major`: Major version number (breaking changes).
## - `minor`: Minor version number (backwards-compatible features).
## - `patch`: Patch version number (backwards-compatible fixes).
## - `prerelease`: Prerelease label string (e.g. `"alpha.1"`), or `""`.
## - `build`: Build metadata string (e.g. `"build.2026"`), or `""`.
## - `raw`: Normalized version string (e.g. `"1.2.3-alpha.1+build.2026"`).
pub struct Version
    major: int,
    minor: int,
    patch: int,
    prerelease: string,
    build: string,
    raw: string
end

# ───────────────────────────────────────────────────────────────
# Internal String & Character Helpers (private to package)
# ───────────────────────────────────────────────────────────────

## Trims leading and trailing whitespace from a string.
pub function _sv_trim(s: string) -> string
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen
        let ch = char_at(s, start_idx)
        if ch not in [" ", "\t", "\r", "\n"]
            break
        end
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx
        let ch = char_at(s, end_idx)
        if ch not in [" ", "\t", "\r", "\n"]
            break
        end
        end_idx -= 1
    end
    return s[start_idx..(end_idx + 1)]
end

# Checks whether a string is a single ASCII digit character.
pub function _sv_is_digit(ch: string) -> int
    if len(ch) != 1
        return 0
    end
    let c = ord(ch)
    return c >= 48 and c <= 57
end

# Checks whether a string consists solely of ASCII digits.
pub function _sv_is_all_digits(s: string) -> int
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    while i < slen
        if _sv_is_digit(char_at(s, i)) == 0
            return 0
        end
        i += 1
    end
    return 1
end

# Splits a string on a single-character delimiter, keeping empty segments.
pub function _sv_split_char(s: string, delim: string) -> array
    let res = []
    let slen = len(s)
    let cur = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == delim
            res.push(cur)
            cur = ""
        else
            cur += ch
        end
        i += 1
    end
    res.push(cur)
    return res
end

# Returns the first index of a needle substring, or -1 when absent.
pub function _sv_index_of(s: string, needle: string) -> int
    let slen = len(s)
    let nlen = len(needle)
    if nlen == 0
        return 0
    end
    if nlen > slen
        return -1
    end
    let i = 0
    while i <= slen - nlen
        if s[i..(i + nlen)] == needle
            return i
        end
        i += 1
    end
    return -1
end

# Checks whether a string starts with the given prefix.
pub function _sv_starts_with(s: string, prefix: string) -> int
    let plen = len(prefix)
    let slen = len(s)
    if plen > slen
        return 0
    end
    return s[0..plen] == prefix
end
