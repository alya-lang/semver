#
# Semantic Versioning 2.0.0 parser, comparator, bumper, and range checker.
# ═══════════════════════════════════════════════════════════════

import "./types.alya"
import "./parser.alya"
import "./comparator.alya"
import "./bumper.alya"
import "./range.alya"

# Public API Facade Functions

# Parses a version string into a Version struct
function parse_version(v_str)
    return parse(v_str)
end

# Checks if a version satisfies a range expression
function check_satisfies(v_str, range_str)
    return satisfies_string(v_str, range_str)
end

# Compares two version strings (-1, 0, 1)
function cmp(s1, s2)
    return compare_strings(s1, s2)
end
